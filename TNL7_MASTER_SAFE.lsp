(defun entity-type (ent) (if (listp ent) (car ent) NIL))
(defun entity-layer (ent) (if (and (listp ent) (>= (length ent) 2)) (cadr ent) NIL))
(defun entity-geometry (ent) (if (and (listp ent) (>= (length ent) 3)) (caddr ent) NIL))
(defun safe-assoc (key alist)
  (if (listp alist)
      (assoc key alist)
      NIL))
(defun safe-cdr (x)
  (if (listp x)
      (cdr x)
      NIL))
(defun safe-car (x)
  (if (listp x)
      (car x)
      NIL))
(defun geometry-get (geom key)
  (if (listp geom)
      (safe-cdr (safe-assoc key geom))
      NIL))
(defun as-2d-point (v)
  (cond
    ((and (listp v) (>= (length v) 2)) v)
    ((and (listp v) (safe-assoc 'x v) (safe-assoc 'y v))
      (list (safe-cdr (safe-assoc 'x v)) (safe-cdr (safe-assoc 'y v))))
    ((numberp v) (list v 0.0))
    ((and (listp v) (= (length v) 1)) (list (safe-car v) 0.0))
    (T (list 0.0 0.0))))
(defun point-x (p)
  (let ((pp (as-2d-point p)))
    (if (and (listp pp) (> (length pp) 0)) (car pp) 0.0)))
(defun point-y (p)
  (let ((pp (as-2d-point p)))
    (if (and (listp pp) (> (length pp) 1)) (cadr pp) 0.0)))
(defun test-first-contour-entity ()
  (if (and (listp *tnl7-contour*) (> (length *tnl7-contour*) 0))
      (let* ((ent (car *tnl7-contour*))
             (et (entity-type ent))
             (ly (entity-layer ent))
             (geom (entity-geometry ent)))
        (and (= et "LWPOLYLINE")
             (= ly "CACEM - LINEE SCHEDA")
             (listp geom)))
    NIL)
)

(defun create-layer (name / layer-exists)
  (setq layer-exists (tblsearch "LAYER" name))
  (if (null layer-exists)
      (progn
        (command "_.LAYER" "_MAKE" name "")
        T)
    )
  T
)

(defun ensure-layers ()
  (mapcar 'create-layer '(
    "CACEM - LINEE SCHEDA"
    "CACEM - ARMATURA"
    "CACEM - GANCI DEHA"
    "CACEM - HALFEN"
    "CACEM - TREFOLI"
    "CACEM-QUOTE"
    "CACEM - TESTI"
    "CACEM-TESTI"
    "CACEM - PIASTRA POSIZIONE Y"
    "CACEM-TRAVE U CANALE"
    "CACEM - TABELLE"))
)

(defun create-line-entity (p1 p2 layer)
  (let* ((p1p (as-2d-point p1))
         (p2p (as-2d-point p2)))
    (entmake (list
      (cons 0 "LINE")
      (cons 8 layer)
      (cons 10 (point-x p1p)) (cons 20 (point-y p1p)) (cons 30 0.0)
      (cons 11 (point-x p2p)) (cons 21 (point-y p2p)) (cons 31 0.0))))

(defun create-circle-entity (center radius layer)
  (let* ((cp (as-2d-point center)))
    (entmake (list
      (cons 0 "CIRCLE")
      (cons 8 layer)
      (cons 10 (point-x cp)) (cons 20 (point-y cp)) (cons 30 0.0)
      (cons 40 radius)))))

(defun create-arc-entity (center radius start-angle end-angle layer)
  (let* ((cp (as-2d-point center)))
    (entmake (list
      (cons 0 "ARC")
      (cons 8 layer)
      (cons 10 (point-x cp)) (cons 20 (point-y cp)) (cons 30 0.0)
      (cons 40 radius)
      (cons 50 start-angle)
      (cons 51 end-angle)))))

(defun create-lwpolyline-entity (pts bulges closed layer)
  (entmake (append
    (list
      (cons 0 "LWPOLYLINE")
      (cons 8 layer)
      (cons 90 (length pts))
      (cons 70 (if closed 1 0)))
    (apply 'append
      (mapcar '(lambda (pt bulge)
                (let* ((pp (as-2d-point pt)))
                  (list (cons 10 (point-x pp)) (cons 20 (point-y pp)) (cons 42 bulge))))
              pts bulges)))
)
)

(defun create-text-entity (content pos height rotation layer)
  (let* ((pp (as-2d-point pos)))
    (entmake (list
      (cons 0 "TEXT")
      (cons 8 layer)
      (cons 10 (point-x pp)) (cons 20 (point-y pp)) (cons 30 0.0)
      (cons 40 height)
      (cons 50 rotation)
      (cons 1 content)))))

(defun create-mtext-entity (content pos height layer)
  (let* ((pp (as-2d-point pos)))
    (entmake (list
      (cons 0 "MTEXT")
      (cons 8 layer)
      (cons 10 (point-x pp)) (cons 20 (point-y pp)) (cons 30 0.0)
      (cons 41 height)
      (cons 1 content)))))

(defun create-dimension-visual (point1 point2 text-pos label layer)
  (let* ((p1p (as-2d-point point1))
         (p2p (as-2d-point point2))
         (tpp (as-2d-point text-pos)))
    (create-line-entity p1p p2p layer)
    (create-line-entity (list (point-x p1p) (+ (point-y p1p) 0.5)) (list (point-x p2p) (+ (point-y p2p) 0.5)) layer)
    (create-text-entity label tpp 0.12 0.0 layer)))

(defun draw-primitive (ent)
  (let* ((ent-type (entity-type ent))
         (ent-layer (entity-layer ent))
         (geom (entity-geometry ent)))
    (cond
      ((= ent-type "LINE")
        (create-line-entity
          (list (cdr (assoc 'x (geometry-get geom 'start))) (cdr (assoc 'y (geometry-get geom 'start))))
          (list (cdr (assoc 'x (geometry-get geom 'end))) (cdr (assoc 'y (geometry-get geom 'end))))
          ent-layer))
      ((= ent-type "ARC")
        (create-arc-entity
          (list (cdr (assoc 'x (geometry-get geom 'center))) (cdr (assoc 'y (geometry-get geom 'center))))
          (geometry-get geom 'radius)
          (geometry-get geom 'start_angle)
          (geometry-get geom 'end_angle)
          ent-layer))
      ((= ent-type "CIRCLE")
        (create-circle-entity
          (list (cdr (assoc 'x (geometry-get geom 'center))) (cdr (assoc 'y (geometry-get geom 'center))))
          (geometry-get geom 'radius)
          ent-layer))
      ((= ent-type "LWPOLYLINE")
        (create-lwpolyline-entity
          (mapcar '(lambda (v) (list (cdr (assoc 'x v)) (cdr (assoc 'y v)))) (geometry-get geom 'vertices))
          (if (geometry-get geom 'bulges) (geometry-get geom 'bulges) (mapcar '(lambda (v) 0.0) (geometry-get geom 'vertices)))
          (geometry-get geom 'closed)
          ent-layer))
      ((= ent-type "TEXT")
        (create-text-entity
          (geometry-get geom 'content)
          (list (cdr (assoc 'x (geometry-get geom 'position))) (cdr (assoc 'y (geometry-get geom 'position))))
          (geometry-get geom 'height)
          (geometry-get geom 'rotation)
          ent-layer))
      ((= ent-type "MTEXT")
        (create-mtext-entity
          (geometry-get geom 'content)
          (list (cdr (assoc 'x (geometry-get geom 'position))) (cdr (assoc 'y (geometry-get geom 'position))))
          (geometry-get geom 'height)
          ent-layer))
      ((= ent-type "DIMENSION")
        (create-dimension-visual
          (list (cdr (assoc 'x (geometry-get geom 'point1))) (cdr (assoc 'y (geometry-get geom 'point1))))
          (list (cdr (assoc 'x (geometry-get geom 'point2))) (cdr (assoc 'y (geometry-get geom 'point2))))
          (list (cdr (assoc 'x (geometry-get geom 'text_position))) (cdr (assoc 'y (geometry-get geom 'text_position))))
          (rtos (geometry-get geom 'value) 2 1)
          ent-layer))
      (T NIL))
  )
)

(defun draw-section (items)
  (foreach item items
    (draw-primitive item))
)

(defun create-holes ()
  (foreach item *tnl7-holes*
    (foreach primitive (geometry-get (entity-geometry item) 'world_geometry)
      (draw-primitive primitive))))

(defun create-reinforcement ()
  (draw-section *tnl7-reinforcement*))

(defun create-halfens ()
  (draw-section *tnl7-halfens*))

(defun create-deha ()
  (draw-section *tnl7-deha*))

(defun create-strands ()
  (draw-section *tnl7-strands*))

(defun create-mask ()
  (draw-section *tnl7-mask*))

(defun create-dimensions ()
  (foreach item *tnl7-dimensions*
    (if (= (entity-type item) "DIMENSION")
      (create-dimension-visual
        (list (cdr (assoc 'x (geometry-get (entity-geometry item) 'point1))) (cdr (assoc 'y (geometry-get (entity-geometry item) 'point1))))
        (list (cdr (assoc 'x (geometry-get (entity-geometry item) 'point2))) (cdr (assoc 'y (geometry-get (entity-geometry item) 'point2))))
        (list (cdr (assoc 'x (geometry-get (entity-geometry item) 'text_position))) (cdr (assoc 'y (geometry-get (entity-geometry item) 'text_position))))
        (rtos (geometry-get (entity-geometry item) 'value) 2 1)
        (entity-layer item)
      )
    )
  )
)

(defun create-text-elements ()
  (foreach item *tnl7-texts*
    (if (= (entity-type item) "TEXT")
      (create-text-entity
        (geometry-get (entity-geometry item) 'content)
        (list (cdr (assoc 'x (geometry-get (entity-geometry item) 'position))) (cdr (assoc 'y (geometry-get (entity-geometry item) 'position))))
        (geometry-get (entity-geometry item) 'height)
        (geometry-get (entity-geometry item) 'rotation)
        (entity-layer item)
      )
    )
  )
)

(defun create-tnl-label (n)
  (setq *tnl7-label* (strcat "TNL" (itoa n)))
  (create-text-entity *tnl7-label* (list -226.000 136.500) 0.25 0.0 "CACEM - TESTI")
  (create-text-entity *tnl7-label* (list -211.500 126.200) 0.10 0.0 "CACEM - PIASTRA POSIZIONE Y")
)

(defun c:TNLMASTER ()
  (tnl7-ensure-data)
  (setq *tnl7-input* (getstring T "Numero TNL <7>: "))
  (if (= *tnl7-input* "")
      (setq *tnl7-input* "7"))
  (setq *tnl7-number* (atoi *tnl7-input*))
  (if (zerop *tnl7-number*)
      (setq *tnl7-number* 7))
  (setq *tnl7-label* (strcat "TNL" (itoa *tnl7-number*)))
  (command "_.UNDO" "_BEGIN")
  (ensure-layers)
  (draw-section *tnl7-contour*)
  (create-holes)
  (create-reinforcement)
  (create-halfens)
  (create-deha)
  (create-strands)
  (create-mask)
  (create-dimensions)
  (create-text-elements)
  (create-tnl-label *tnl7-number*)
  (command "_.UNDO" "_END")
  (princ (strcat "TNL7 recreated with label: " *tnl7-label*))
  (princ)
)

(princ "TNL7_MASTER loaded. Type TNLMASTER to generate the drawing.")
(princ)
